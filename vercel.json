{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index.js" },
    { "source": "/index.html", "destination": "/api/index.js" },
    { "source": "/product.html", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/admin.html", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "views/**"
    }
  }
}
